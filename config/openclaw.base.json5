{
  gateway: {
    mode: "local",
    trustedProxies: ["127.0.0.1", "::1"],
    controlUi: {
      allowedOrigins: ["https://broker-dashboard-flax.vercel.app"],
    },
  },
  agents: {
    defaults: {
      sandbox: {
        mode: "all",
        workspaceAccess: "rw",
      },
      skipBootstrap: true,
      bootstrapMaxChars: 20000,
      bootstrapTotalMaxChars: 150000,
      heartbeat: {
        every: "1h",
      },
    },
  },
  tools: {
    exec: {
      host: "gateway",
      security: "full",
      ask: "off",
      pathPrepend: ["/root/.local/bin"],
    },
  },
}
