{
  gateway: {
    mode: "local",
    controlUi: {
      allowedOrigins: ["https://broker-dashboard-flax.vercel.app"],
    },
  },
  agents: {
    defaults: {
      skipBootstrap: true,
      bootstrapMaxChars: 20000,
      bootstrapTotalMaxChars: 150000,
      heartbeat: {
        every: "1h",
      },
    },
  },
  tools: {
    exec: {
      host: "sandbox",
      pathPrepend: ["/sandbox/.local/bin"],
    },
  },
}
